DATABASE_URL=postgres://jevtrieval:jevtrieval@localhost:5432/jevtrieval?sslmode=disable
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_QUESTION_MODEL=openai/gpt-4o-mini
OPENROUTER_ANSWER_MODEL=openai/gpt-4o-mini
OPENROUTER_JEV_MODEL=~typesafe/jev-latest

RETRIEVAL_LIMIT=50
JEV_CONCURRENCY=8
JEV_COVERAGE_THRESHOLD=0.70
HTTP_ADDR=:8080

OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=jevtrieval
ALLOWED_ORIGIN=http://localhost:3000
